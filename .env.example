# News Curator Environment Variables
# Copy this file to .env and fill in your values

# AI APIs (at least one recommended for summarization)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Email Settings (for sending reports)
GMAIL_EMAIL=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# bkend.ai Backend (optional - for cloud storage)
BKEND_API_KEY=your-bkend-api-key
BKEND_SERVICE_URL=https://your-service.bkend.io
